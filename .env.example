# ==============================================================================
# TutorBox Edge Appliance - Environment Configuration Reference
# ==============================================================================
# Copy this template to '.env' to customize local development or production settings.

# ------------------------------------------------------------------------------
# 1. Database Configuration (SQLite WAL Mode)
# ------------------------------------------------------------------------------
# Path to the primary SQLite database file.
# Defaults to '.cache/db/tutorbox.db' relative to project root.
DATABASE_PATH=.cache/db/tutorbox.db

# Database busy timeout in milliseconds (prevents lock contention under concurrency).
# Default: 5000 (5 seconds)
DB_BUSY_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 2. Security & Authentication Guardrails
# ------------------------------------------------------------------------------
# Bcrypt hash calculation cost factor (work factor). Production default: 12.
BCRYPT_ROUNDS=12

# Maximum consecutive failed login attempts before a user is locked out.
# Default: 5
AUTH_MAX_ATTEMPTS=5

# Duration of login lockout in seconds after exceeding AUTH_MAX_ATTEMPTS.
# Default: 30
AUTH_LOCKOUT_SECONDS=30

# Maximum unique usernames tracked in memory by the brute-force lockout guard.
# Default: 10000
AUTH_MAX_TRACKED_KEYS=10000

# Student self-signup rate limiting (sliding window to prevent account flooding).
# Maximum account creation events allowed in the sliding window. Default: 30.
SIGNUP_RATE_LIMIT_MAX_EVENTS=30

# Sliding window duration in seconds for student self-signup rate limiting. Default: 60.
SIGNUP_RATE_LIMIT_WINDOW_SECONDS=60

# ------------------------------------------------------------------------------
# 3. Local SLM (Small Language Model) & Edge AI Inference
# ------------------------------------------------------------------------------
# Base URL of OpenAI-compatible completion server (llama.cpp, vLLM, LM Studio, Ollama).
# Default for Jetson llama.cpp: http://127.0.0.1:8080/v1
# Default for LM Studio: http://127.0.0.1:1234/v1
# Default for Ollama: http://127.0.0.1:11434/v1
SLM_BASE_URL=http://127.0.0.1:8080/v1

# Target model identifier registered on the inference server.
# Default: default
# Examples: qwen2.5-coder-3b-instruct, microsoft/phi-4-mini-reasoning, llama-3.2-3b-instruct
SLM_MODEL_NAME=default

# Sampling temperature for diagnostic question and distractor generation.
# Range: 0.0 (deterministic) to 1.0 (creative). Default: 0.7
SLM_TEMPERATURE=0.7

# HTTP socket timeout in seconds for LLM completion requests.
# Increase for reasoning models (e.g., phi-4-mini-reasoning, deepseek-r1) or edge devices.
# Default: 60.0 (seconds)
SLM_TIMEOUT_SECONDS=60.0

# ------------------------------------------------------------------------------
# 4. Quiz Generation & Pedagogical Pipeline
# ------------------------------------------------------------------------------
# Maximum rejection sampling feedback cycles for generating valid SymPy-verified questions.
# Default: 3
QUIZ_MAX_RETRIES=3
