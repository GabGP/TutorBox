# ==============================================================================
# TutorBox Edge Appliance - Environment Configuration Reference
# ==============================================================================
# Copy this template to '.env' to customize local development or production settings.

# ------------------------------------------------------------------------------
# 1. Database Configuration (SQLite WAL Mode)
# ------------------------------------------------------------------------------
# Path to the primary SQLite database file.
# Defaults to '.cache/db/tutorbox.db' relative to project root.
DATABASE_PATH=.cache/db/tutorbox.db

# Database busy timeout in milliseconds (prevents lock contention under concurrency).
# Default: 5000 (5 seconds)
DB_BUSY_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 2. Security & Authentication Guardrails
# ------------------------------------------------------------------------------
# Bcrypt hash calculation cost factor (work factor). Production default: 12.
BCRYPT_ROUNDS=12

# Maximum consecutive failed login attempts before a user is locked out.
# Default: 5
AUTH_MAX_ATTEMPTS=5

# Duration of login lockout in seconds after exceeding AUTH_MAX_ATTEMPTS.
# Default: 30
AUTH_LOCKOUT_SECONDS=30

# Maximum unique usernames tracked in memory by the brute-force lockout guard.
# Default: 10000
AUTH_MAX_TRACKED_KEYS=10000

# Bootstrap teacher account created on first startup so the classroom quiz host can
# log in and generate questions. Change the PIN before deploying; set SEED_TEACHER_PIN
# to an empty value to disable seeding.
SEED_TEACHER_USERNAME=teacher1
SEED_TEACHER_PIN=1234

# Student self-signup rate limiting (sliding window to prevent account flooding).
# Maximum account creation events allowed in the sliding window. Default: 30.
SIGNUP_RATE_LIMIT_MAX_EVENTS=30

# Sliding window duration in seconds for student self-signup rate limiting. Default: 60.
SIGNUP_RATE_LIMIT_WINDOW_SECONDS=60

# ------------------------------------------------------------------------------
# 3. Local SLM (Small Language Model) & Edge AI Inference
# ------------------------------------------------------------------------------
# Base URL of OpenAI-compatible completion server (llama.cpp, vLLM, LM Studio, Ollama).
# Default for Jetson llama.cpp: http://127.0.0.1:8080/v1
# Default for LM Studio: http://127.0.0.1:1234/v1
# Default for Ollama: http://127.0.0.1:11434/v1
SLM_BASE_URL=http://127.0.0.1:8080/v1

# Target model identifier registered on the inference server.
# Default: default
# Examples: qwen2.5-coder-3b-instruct, microsoft/phi-4-mini-reasoning, llama-3.2-3b-instruct
SLM_MODEL_NAME=default

# Sampling temperature for diagnostic question and distractor generation.
# Range: 0.0 (deterministic) to 1.0 (creative). Default: 0.7
SLM_TEMPERATURE=0.5

# HTTP socket timeout in seconds for LLM completion requests.
# Increase for reasoning models (e.g., phi-4-mini-reasoning, deepseek-r1) or edge devices.
# Default: 60.0 (seconds)
SLM_TIMEOUT_SECONDS=60.0

# ------------------------------------------------------------------------------
# 4. Quiz Generation & Pedagogical Pipeline
# ------------------------------------------------------------------------------
# Maximum rejection sampling feedback cycles for generating valid SymPy-verified questions.
# Default: 3
QUIZ_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# 5. Offline Classroom Voice (espeak-ng & Neural Piper) — the >51% spoken intervention
# ------------------------------------------------------------------------------
# When a single diagnostic distractor takes more than 51% of the votes, the teacher's device
# reads the misconception explanation out loud.
# Set to false to keep the appliance silent (the written explanation still appears).
# Default: true
TTS_ENABLED=true

# Engine selection hierarchy in 'auto':
# 1. Primary Winner: 'qwen3-tts' (1.7B neural Base model, native Spanish cadence, CUDA when available)
# 2. Fast Secondary: 'sherpa' (Sherpa-ONNX VITS using the Piper-compatible checkpoint)
# 3. Fast Tertiary: 'piper' (Piper VITS using the same Spanish checkpoint family)
# 4. Ultimate Fallback: 'espeak' (Formant voice; robotic but dependable)
# Options: 'auto', 'qwen3-tts', 'sherpa', 'piper', 'kokoro', 'espeak'. Default: auto
TTS_ENGINE=auto

# Formant Fallback Engine (espeak-ng):
# espeak executable. Empty: auto-detect espeak-ng, then legacy espeak.
TTS_ESPEAK_BINARY=

# Voice for Spanish. es-419 is espeak-ng's Latin American Spanish (legacy espeak: es-la).
# Falls back to es-la, then es (Castilian), when the build lacks it.
# Default: es-419
TTS_VOICE=es-419

# Voice for K'iche'. Empty: /speech?lang=quc answers 503 if formant fallback is active.
TTS_VOICE_QUC=

# Speaking rate in words per minute (80-450). 150 is slower than espeak's 175 default,
# which primary-school classrooms follow more easily. Default: 150
TTS_WORDS_PER_MINUTE=150

# Voice pitch (0-99) and amplitude (0-200) for classroom speakers. Defaults: 45 / 180
TTS_PITCH=45
TTS_AMPLITUDE=180

# Hard stop for a synthesis call, in seconds. Default: 10.0
TTS_TIMEOUT_SECONDS=10.0

# Maximum characters spoken per intervention; longer text is cut at a sentence end. Default: 600
TTS_MAX_CHARS=600

# Neural Voice Engine (Piper-TTS VITS via ONNX Runtime):
# Executable path for standalone piper binary. Empty: auto-detected in PATH or Python runtime.
TTS_PIPER_BINARY=

# Directory where pre-downloaded ONNX models and configs reside. Default: /opt/tutorbox/models/tts
TTS_PIPER_MODEL_DIR=/opt/tutorbox/models/tts

# Default Spanish ONNX model file. Default: es_ES-sharvard-medium.onnx
TTS_PIPER_MODEL_ES=es_ES-sharvard-medium.onnx

# Speaker ID for Spanish voice (for multi-speaker models like sharvard: 1 = female educator, 0 = male educator). Default: 1
TTS_PIPER_SPEAKER_ES=1

# Default K'iche' Mayan ONNX model file. Default: quc_Latn-maya-medium.onnx
TTS_PIPER_MODEL_QUC=quc_Latn-maya-medium.onnx

# Speaker ID for K'iche' voice. Default: 0
TTS_PIPER_SPEAKER_QUC=0

# Speaking speed multiplier for Piper (0.5 to 2.5). 1.12 provides a calm primary-school teacher pace. Default: 1.12
TTS_PIPER_LENGTH_SCALE=1.12

# Acoustic generator variance (0.0 to 2.0). 0.35 stabilizes pitch and eliminates audio peaking/wobble. Default: 0.35
TTS_PIPER_NOISE_SCALE=0.35

# Syllable duration variance (0.0 to 2.0). 0.45 enforces rhythmic, intelligible syllable timing. Default: 0.45
TTS_PIPER_NOISE_W_SCALE=0.45

# Extended Candidate TTS Engines (for A/B Benchmarking):
# Sherpa-ONNX configuration (threads set to 6 to mirror Jetson Orin Nano CPU cluster)
TTS_SHERPA_MODEL_ES=es_ES-sharvard-medium.onnx
TTS_SHERPA_THREADS=6
TTS_SHERPA_PROVIDER=auto

# Moss-Nano ONNX configuration
TTS_MOSS_MODEL=moss-nano-es.onnx

# Kokoro-82M ONNX configuration:
# Asset directory containing voices.bin and tokens.txt (upstream k2-fsa repo identifier)
TTS_KOKORO_MODEL_DIR=kokoro-int8-multi-lang-v1_0
# Model weights file located inside TTS_KOKORO_MODEL_DIR:
#   'model.onnx'      = unquantized FP32
#   'model.int8.onnx' = quantized INT8
TTS_KOKORO_MODEL_FILE=model.onnx
TTS_KOKORO_VOICE=es
TTS_KOKORO_SPEAKER_ID=53
TTS_KOKORO_PROVIDER=auto

# MeloTTS configuration
TTS_MELO_VOICE=ES

# Qwen3-TTS (Primary Neural Voice, 1.7B autoregressive model + 12 Hz codec, CUDA when available):
# Optional llama-tts binary override. Empty: search alongside the model, standard install locations, and PATH.
TTS_QWEN_BINARY=
# Model path (auto-detects in .cache/models/tts/qwen/ or /opt/tutorbox/models/tts/qwen/ if empty)
TTS_QWEN_GGUF_PATH=
# Short context for classroom utterances; reduces the default Qwen KV-cache allocation. Default: 1024.
TTS_QWEN_CONTEXT=1024
# CPU-side thread count used by llama-tts for prompt/host work. Default: 6.
TTS_QWEN_THREADS=6
# Fixed seed keeps repeated benchmark runs and classroom output reproducible. Use -1 for random sampling.
TTS_QWEN_SEED=42
# Optional reference WAV/MP3 for Base-model voice cloning; empty uses the model default.
TTS_QWEN_SPEAKER_FILE=

# ------------------------------------------------------------------------------
# 6. Captive Portal — auto-open the student page when a phone joins the Wi-Fi
# ------------------------------------------------------------------------------
# Phones probe a well-known HTTP URL right after joining (Android /generate_204,
# iOS /hotspot-detect.html, Windows /connecttest.txt). The classroom router resolves
# every name to the appliance, the backend answers those probes with a 302 to the URL
# below, and the phone's sign-in browser opens it. /api/* is never redirected.
# Requires: backend reachable on port 80 (infra/nginx) and the router's static lease +
# catch-all DNS (infra/glinet/initial.md §5). See infra/captive-portal.md.
# Set to false to answer probes with a plain 404 (phones just report "no internet").
# Default: true
CAPTIVE_PORTAL_ENABLED=true

# Absolute URL the probes redirect to. Use http://192.168.8.2/alumno/ if the router does
# not resolve the 'tutorbox' name. Default: http://tutorbox/alumno/
CAPTIVE_PORTAL_URL=http://tutorbox/alumno/

# ------------------------------------------------------------------------------
# 7. Classroom Web Client (Pilas / PWA) Static Directory
# ------------------------------------------------------------------------------
# Directory where static files for /maestro/, /alumno/, /pantalla/, and /static/
# are served from.
# Default: .cache/pwa/dist (built React PWA client from pwa/app)
# Legacy fallback: pwa/pilas (vanilla reference client) — set explicitly to opt in.
PWA_STATIC_DIR=.cache/pwa/dist

# ------------------------------------------------------------------------------
# 8. Unified Appliance Logging & Diagnostics
# ------------------------------------------------------------------------------
# Minimum logging level for backend appliance and Uvicorn loggers.
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL. Default: INFO
LOG_LEVEL=INFO

# Suppress repetitive Wi-Fi captive portal probes (/generate_204, /hotspot-detect.html, etc.)
# from flooding Uvicorn access logs. Default: false
LOG_SUPPRESS_PROBES=false

# ------------------------------------------------------------------------------
# 9. Python bytecode & virtualenv location (keep repo clean, all caches in .cache)
# ------------------------------------------------------------------------------
# Redirects ALL __pycache__ under .cache/pycache instead of next to sources.
# Requires Python >= 3.8. run.py also sets this for its uvicorn subprocess,
# but for run.py's own bytecode and direct `uv run` calls you must export it
# in the shell BEFORE Python starts:
#   Linux/macOS:  export PYTHONPYCACHEPREFIX="$PWD/.cache/pycache"
#   Windows (PowerShell): $env:PYTHONPYCACHEPREFIX="$PWD\.cache\pycache"
# pytest already sets this via backend/pyproject.toml [tool.pytest_env].
PYTHONPYCACHEPREFIX=.cache/pycache

# Single shared virtualenv for the whole repo (used by run.py).
# Export before `uv sync`/`uv run` so `backend/.venv` is never recreated:
#   Linux/macOS:  export UV_PROJECT_ENVIRONMENT="$PWD/.cache/venv"
#   Windows (PowerShell): $env:UV_PROJECT_ENVIRONMENT="$PWD\.cache\venv"
UV_PROJECT_ENVIRONMENT=.cache/venv
