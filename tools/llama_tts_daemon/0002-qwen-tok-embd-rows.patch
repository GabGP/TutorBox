+uint32_t llama_model_get_tok_embd_row(const struct llama_model * model, llama_token token, float * out) {
+    const ggml_tensor * tensor = model->tok_embd;
+    if (tensor == nullptr || out == nullptr || token < 0 || (int64_t) token >= tensor->ne[1]) {
+        return 0;
+    }
+
+    const int64_t n_embd   = tensor->ne[0];
+    const size_t  row_size = ggml_row_size(tensor->type, n_embd);
+    const size_t  offset   = (size_t) token * row_size;
+
+    if (tensor->type == GGML_TYPE_F32) {
+        ggml_backend_tensor_get(tensor, out, offset, row_size);
+        return (uint32_t) n_embd;
+    }
+
+    std::vector<uint8_t> buf(row_size);
+    ggml_backend_tensor_get(tensor, buf.data(), offset, row_size);
+
+    const ggml_type_traits * traits = ggml_get_type_traits(tensor->type);
+    if (tensor->type == GGML_TYPE_F16) {
+        ggml_fp16_to_fp32_row((const ggml_fp16_t *) buf.data(), out, n_embd);
+    } else if (tensor->type == GGML_TYPE_BF16) {
+        ggml_bf16_to_fp32_row((const ggml_bf16_t *) buf.data(), out, n_embd);
+    } else if (ggml_is_quantized(tensor->type) && traits->to_float != nullptr) {
+        traits->to_float(buf.data(), out, n_embd);
+    } else {
+        return 0;
+    }
+
+    return (uint32_t) n_embd;
+}
