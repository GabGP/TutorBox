      "B": {
        "misconception": "cross_multiplied_for_product",
        "explanation": "Multiplicaste en cruz en vez de numerador con numerador y denominador con denominador."
      },
      "C": {
        "misconception": "multiplied_only_numerators",
        "explanation": "Multiplicaste solo los numeradores y dejaste el primer denominador."
      },
      "D": {
        "misconception": "forgot_to_invert_divisor",
        "explanation": "Invertiste una fracción como en una división en vez de multiplicar directo."
      }
    }
  },
