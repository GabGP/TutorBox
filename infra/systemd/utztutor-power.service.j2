# Utz'tutor — apply the 25W clock caps at boot.
#
# On the Orin Nano Super dev kit, nvpmodel.service fails at boot (it asks for a reboot and gets
# no answer), so the CPU and GPU max clocks stay at the MAXN_SUPER values. This unit writes the
# 25W caps itself, after NVIDIA's boot script and nvpmodel have run. What it writes is in
# infra/systemd/utztutor-power-caps.sh.
#
# This file is a template: infra/ansible/jetson.yml fills in the checkout path and installs it
# as /etc/systemd/system/utztutor-power.service.
#
# Install or update:
#   cd infra/ansible && ansible-playbook jetson.yml -K --tags services
#   cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq   # expect 1344000

[Unit]
Description=Utz'tutor 25W clock caps
After=nvpower.service nvpmodel.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart={{ repo_dir }}/infra/systemd/utztutor-power-caps.sh

[Install]
WantedBy=multi-user.target
