# Utz'tutor backend — FastAPI API + Pilas classroom pages + captive-portal answers.
#
# Runs uvicorn on 0.0.0.0:8000 from the repository checkout; nginx (infra/nginx/utztutor.conf)
# publishes it on port 80. This file is a template: infra/ansible/jetson.yml fills in the user
# and the checkout path, and installs it as /etc/systemd/system/utztutor-backend.service.
#
# Install or update:
#   cd infra/ansible && ansible-playbook jetson.yml -K --tags services
#   systemctl status utztutor-backend && ss -ltnp | grep ':8000 '
#
# No EnvironmentFile: the app reads <repo>/.env itself (backend/src/core/config/env_loader.py);
# an EnvironmentFile here would silently override it. Single worker only: SQLite plus
# in-memory rate limiters and session state must not be duplicated across processes.

[Unit]
Description=Utz'tutor backend (FastAPI + Pilas pages) on :8000
After=network-online.target ollama.service
# Ollama serves the quiz and tutor models. Wants, not Requires: the seed question bank
# keeps the class running when the model server is down.
Wants=network-online.target ollama.service

[Service]
Type=simple
User={{ app_user }}
WorkingDirectory={{ repo_dir }}/backend
ExecStart={{ repo_dir }}/.cache/venv/bin/python -m uvicorn main:app --app-dir {{ repo_dir }}/backend/src --host 0.0.0.0 --port 8000
# Keep ALL __pycache__ under <repo>/.cache/pycache (repo policy). Must be set
# here (not in .env) because Python reads it at startup, before .env is loaded.
Environment=PYTHONPYCACHEPREFIX={{ repo_dir }}/.cache/pycache
Restart=on-failure
RestartSec=2
# The app only writes under <repo>/.cache (SQLite DB, bytecode, caches);
# keep the rest of the system read-only.
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
